# =========================
# Redis Configuration
# =========================
REDIS_HOST=<redis-host-or-private-ip>
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASS=<redis-password>
REDIS_QUEUE_NAME=email-processing-queue

# ===== AWS S3 (PDF storage) =====
AWS_REGION=us-east-1
AWS_S3_BUCKET=compression-care-pdfs

# Leave empty if using an EC2 IAM Role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =========================
# OpenAI Configuration
# =========================
OPENAI_API_KEY=sk-your-openai-api-key

# =========================
# MongoDB Configuration
# =========================
MONGODB_URI=mongodb://<mongodb-host>:27017
MONGODB_DB=compression-care
MONGODB_COLLECTION=emails

# =========================
# Client Configuration
# =========================

# Fixed value (do not change)
PROCESSORS=client

# Send result to Base URL of the client service
CLIENT_URL=http://localhost:3000